FOUNDRY_API_KEY=replace-with-a-long-random-key
FOUNDRY_DATABASE_PATH=/data/foundry.db
FOUNDRY_RUNTIME=mock
FOUNDRY_PUBLIC_SIGNUP=false

# Browser preview/docs access. Use a separate secret from FOUNDRY_API_KEY.
FOUNDRY_PREVIEW_USER=client
FOUNDRY_PREVIEW_PASSWORD=


# OpenSandbox backend (FOUNDRY_RUNTIME_BACKEND=opensandbox). Always set the
# OpenSandbox server's own API key too; an unauthenticated sandbox server is
# a remote-code-execution endpoint.
FOUNDRY_OPENSANDBOX_DOMAIN=127.0.0.1:8080
FOUNDRY_OPENSANDBOX_PROTOCOL=http
FOUNDRY_OPENSANDBOX_API_KEY=
FOUNDRY_OPENSANDBOX_DEFAULT_IMAGE=opensandbox/desktop:latest
FOUNDRY_OPENSANDBOX_TIMEOUT_MINUTES=60
# Comma-separated egress allowlist. Empty = the sandbox cannot reach anything.
FOUNDRY_OPENSANDBOX_EGRESS_ALLOWLIST=
